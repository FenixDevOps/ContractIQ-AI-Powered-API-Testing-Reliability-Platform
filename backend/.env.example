CONTRACTIQ_APP_NAME=ContractIQ API
CONTRACTIQ_APP_VERSION=0.1.0
CONTRACTIQ_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONTRACTIQ_DATABASE_URL=sqlite:///./contractiq.db
CONTRACTIQ_MAX_UPLOAD_SIZE=5242880
CONTRACTIQ_TEST_ALLOWED_TARGET_HOSTS=
CONTRACTIQ_TEST_ALLOWED_TARGET_PORTS=80,443
CONTRACTIQ_TEST_ALLOW_PRIVATE_TARGETS=false
CONTRACTIQ_TEST_MAX_RESPONSE_BYTES=1048576
CONTRACTIQ_TEST_MAX_CASES_PER_RUN=100