CONTRACTIQ_APP_NAME=ContractIQ API
CONTRACTIQ_APP_VERSION=0.1.0
CONTRACTIQ_ENVIRONMENT=development
CONTRACTIQ_SECRET_KEY=
CONTRACTIQ_ACCESS_TOKEN_EXPIRE_MINUTES=15
CONTRACTIQ_REFRESH_TOKEN_EXPIRE_DAYS=30
CONTRACTIQ_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
CONTRACTIQ_AUTH_COOKIE_SECURE=false
CONTRACTIQ_AUTH_COOKIE_SAMESITE=lax
CONTRACTIQ_AUTH_ALLOW_REGISTRATION=true
CONTRACTIQ_AUTH_REQUIRE_EMAIL_VERIFICATION=false
CONTRACTIQ_EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
CONTRACTIQ_FRONTEND_BASE_URL=http://localhost:5173
CONTRACTIQ_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONTRACTIQ_DATABASE_URL=sqlite:///./contractiq.db
CONTRACTIQ_SMTP_HOST=
CONTRACTIQ_SMTP_PORT=587
CONTRACTIQ_SMTP_USERNAME=
CONTRACTIQ_SMTP_PASSWORD=
CONTRACTIQ_SMTP_FROM_EMAIL=
CONTRACTIQ_SMTP_USE_TLS=true
CONTRACTIQ_SMTP_TIMEOUT_SECONDS=10
CONTRACTIQ_MAX_UPLOAD_SIZE=5242880
CONTRACTIQ_TEST_ALLOWED_TARGET_HOSTS=
CONTRACTIQ_TEST_ALLOWED_TARGET_PORTS=80,443
CONTRACTIQ_TEST_ALLOW_PRIVATE_TARGETS=false
CONTRACTIQ_TEST_MAX_RESPONSE_BYTES=1048576
CONTRACTIQ_TEST_MAX_CASES_PER_RUN=100
CONTRACTIQ_MONITORING_SCHEDULER_ENABLED=true
CONTRACTIQ_MONITORING_MAX_RESPONSE_BYTES=262144
CONTRACTIQ_ANOMALY_MIN_TRAINING_SAMPLES=100
CONTRACTIQ_ANOMALY_RETRAIN_NEW_SAMPLES=50
CONTRACTIQ_ANOMALY_CONTAMINATION=0.05