POSTGRES_DB=contractiq
POSTGRES_USER=contractiq
POSTGRES_PASSWORD=
CONTRACTIQ_SECRET_KEY=
CONTRACTIQ_ALLOWED_ORIGINS=https://contractiq.example.com
CONTRACTIQ_FRONTEND_BASE_URL=https://contractiq.example.com
CONTRACTIQ_PUBLIC_HOST=contractiq.example.com
CONTRACTIQ_AUTH_COOKIE_SECURE=true
CONTRACTIQ_AUTH_COOKIE_SAMESITE=lax
CONTRACTIQ_AUTH_ALLOW_REGISTRATION=false
CONTRACTIQ_AUTH_REQUIRE_EMAIL_VERIFICATION=true
CONTRACTIQ_EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
CONTRACTIQ_SMTP_HOST=
CONTRACTIQ_SMTP_PORT=587
CONTRACTIQ_SMTP_USERNAME=
CONTRACTIQ_SMTP_PASSWORD=
CONTRACTIQ_SMTP_FROM_EMAIL=
CONTRACTIQ_SMTP_USE_TLS=true
CONTRACTIQ_MONITORING_SCHEDULER_ENABLED=true
CONTRACTIQ_TLS_CERT_PATH=/absolute/path/to/fullchain.pem
CONTRACTIQ_TLS_KEY_PATH=/absolute/path/to/privkey.pem
CONTRACTIQ_HTTP_PORT=80
CONTRACTIQ_HTTPS_PORT=443
